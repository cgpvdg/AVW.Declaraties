rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function role(value) {
      return request.auth != null &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == value;
    }
    function trainer(uid) {
      return request.auth != null && request.auth.uid == uid &&
        activeTrainer(get(/databases/$(database)/documents/profiles/$(uid)).data);
    }
    function activeTrainer(data) {
      return (data.role == 'trainer' || (data.role == 'beheerder' && data.get('trainer', false))) &&
        data.get('status', 'active') == 'active' && data.level in [1,2,3,4];
    }
    function validNamePart(value) {
      return value is string && value.size() <= 120 && value.matches('(?s).*\\S.*');
    }
    function validProfileName(data) {
      return !data.keys().hasAny(['name']) &&
        validNamePart(data.firstName) && validNamePart(data.lastName) &&
        (data.namePrefix == '' || validNamePart(data.namePrefix));
    }
    function fullProfileName(data) {
      return data.keys().hasAny(['firstName'])
        ? data.firstName + ' ' + (data.namePrefix == '' ? '' : data.namePrefix + ' ') + data.lastName
        : data.name;
    }
    function validTrainer(data) {
      return (validProfileName(data) || validLegacyName(data)) &&
        data.level in [1,2,3,4] && data.status in ['active','inactive','deleted','pending'];
    }
    function validLegacyName(data) {
      return !data.keys().hasAny(['firstName','namePrefix','lastName']) && validNamePart(data.name);
    }
    function validNameUpdate() {
      return validProfileName(request.resource.data) ||
        (validLegacyName(resource.data) && validLegacyName(request.resource.data));
    }
    function amount(value) {
      return value is number && value >= 0 && value <= 100000;
    }
    function validRate(data) {
      return data.keys().hasOnly(['level1','level2','level3','level4','guidance','kilometers']) &&
        amount(data.level1) && amount(data.level2) && amount(data.level3) && amount(data.level4) &&
        amount(data.guidance) && amount(data.kilometers);
    }
    match /profiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read: if role('beheerder');
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.role == 'trainer' && request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly(['name','firstName','namePrefix','lastName','level','role','status']) && validTrainer(request.resource.data) &&
        !exists(/databases/$(database)/documents/rejectedTrainers/$(uid));
      allow delete: if role('beheerder') && resource.data.role == 'trainer' &&
        resource.data.status == 'pending' && existsAfter(/databases/$(database)/documents/rejectedTrainers/$(uid));
      allow update: if request.auth != null && request.auth.uid == uid &&
        (resource.data.role == 'beheerder' || activeTrainer(resource.data)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','firstName','namePrefix','lastName','level']) &&
        validNameUpdate() &&
        ((resource.data.role == 'beheerder' && !resource.data.get('trainer', false) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['level'])) ||
          ((resource.data.role == 'trainer' || resource.data.get('trainer', false)) &&
            request.resource.data.level in [1,2,3,4]));
      allow update: if role('beheerder') &&
        (resource.data.role == 'trainer' || resource.data.get('trainer', false)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','firstName','namePrefix','lastName','level','status']) &&
        validNameUpdate() && validTrainer(request.resource.data) && request.resource.data.status != 'pending';
      allow update: if request.auth != null && (request.auth.uid == uid || role('beheerder')) &&
        resource.data.keys().hasAny(['name']) && !resource.data.keys().hasAny(['firstName']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','firstName','namePrefix','lastName']) &&
        validProfileName(request.resource.data) && fullProfileName(request.resource.data) == resource.data.name;
    }
    match /rejectedTrainers/{uid} {
      allow create: if role('beheerder') && request.resource.data.keys().hasOnly(['rejected']) &&
        request.resource.data.rejected == true &&
        get(/databases/$(database)/documents/profiles/$(uid)).data.status == 'pending' &&
        !existsAfter(/databases/$(database)/documents/profiles/$(uid));
    }
    match /settings/rates {
      allow read: if role('beheerder') || (request.auth != null && trainer(request.auth.uid));
      allow create, update: if role('beheerder') && validRate(request.resource.data);
    }
    match /profiles/{uid}/recurringDeclarations/{id} {
      allow read: if trainer(uid);
      allow create, update: if trainer(uid) && validRecurringDeclaration(request.resource.data);
    }
    match /profiles/{uid}/recurringDecisions/{id} {
      allow read: if trainer(uid);
      allow create: if trainer(uid) && validRecurringDecision(uid, id, request.resource.data);
    }
    function validRecurringDecision(uid, id, data) {
      let entry = /databases/$(database)/documents/profiles/$(uid)/months/$(data.period)/entries/$(data.day);
      return data.keys().hasOnly(['ruleId','period','day','approved']) &&
        data.ruleId is string && data.ruleId.matches('[A-Za-z0-9]{20}') &&
        validRecurringDate(data.period + '-' + data.day) &&
        id == data.ruleId + '_' + data.period + '-' + data.day &&
        exists(/databases/$(database)/documents/profiles/$(uid)/recurringDeclarations/$(data.ruleId)) &&
        data.approved is bool && !exists(entry) && existsAfter(entry) == data.approved;
    }
    function validRecurringDeclaration(data) {
      return data.keys().hasOnly(['name','startDate','endDate','repeat','interval','unit','days',
        'prep','training','guidance','kilometers','expenses']) &&
        validNamePart(data.name) &&
        validRecurringDate(data.startDate) &&
        (data.endDate == '' || (validRecurringDate(data.endDate) && data.startDate <= data.endDate)) &&
        validDeclarationAmounts(data) &&
        data.repeat == true && data.interval is int && data.interval >= 1 && data.interval <= 100 &&
        data.unit in ['dag','week','maand','jaar'] &&
        data.days is list && data.days.hasOnly([1,2,3,4,5,6,7]) &&
        data.days.size() == data.days.toSet().size() &&
        (data.unit == 'week' ? data.days.size() > 0 : data.days.size() == 0);
    }
    function validRecurringDate(value) {
      return value is string && value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }
    match /profiles/{uid}/months/{month} {
      allow read: if role('beheerder') || trainer(uid);
      allow create: if trainer(uid) && month.matches('[0-9]{4}-(0[1-9]|1[0-2])') &&
        request.resource.data.keys().hasOnly(['rates','name','level']) &&
        request.resource.data.name == fullProfileName(get(/databases/$(database)/documents/profiles/$(uid)).data) &&
        request.resource.data.level == get(/databases/$(database)/documents/profiles/$(uid)).data.level &&
        request.resource.data.level in [1,2,3,4] &&
        request.resource.data.rates == get(/databases/$(database)/documents/settings/rates).data;
      allow update: if validDeclarationTransition(uid);
      match /entries/{day} {
        allow read: if role('beheerder') || trainer(uid);
        allow delete: if trainer(uid) && editableDeclaration(uid, month);
        allow create, update: if trainer(uid) && editableDeclaration(uid, month) &&
          day.matches('0[1-9]|[12][0-9]|3[01]') && validEntry(request.resource.data, month, day);
      }
    }
    function editableDeclaration(uid, month) {
      return getAfter(/databases/$(database)/documents/profiles/$(uid)/months/$(month))
        .data.get('status', 'concept') in ['concept', 'rejected'];
    }
    function validDeclarationTransition(uid) {
      let previous = resource.data.get('status', 'concept');
      let next = request.resource.data.status;
      let note = request.resource.data.rejectionNote;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionNote']) &&
        (next == 'rejected'
          ? note is string && note.size() <= 1000 && note.matches('(?s).*\\S.*')
          : note == '') &&
        ((trainer(uid) &&
          ((previous in ['concept', 'rejected'] && next == 'submitted') ||
            (previous == 'submitted' && next == 'concept'))) ||
          (role('beheerder') &&
            ((previous == 'submitted' && next in ['approved', 'rejected']) ||
              (previous in ['approved', 'rejected'] && next == 'submitted'))));
    }
    function validEntry(data, month, day) {
      return data.keys().hasOnly(['date','prep','training','guidance','kilometers','expenses','notes']) &&
        data.date == month + '-' + day && validDeclarationAmounts(data) &&
        data.notes is string && data.notes.size() <= 1000;
    }
    function validDeclarationAmounts(data) {
      return amount(data.prep) && amount(data.training) && amount(data.guidance) &&
        data.prep + data.training + data.guidance <= 24 &&
        amount(data.kilometers) && amount(data.expenses);
    }
  }
}
